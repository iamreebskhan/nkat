################################################################################
# Local development environment template.
# Copy to .env and fill in real values. .env is gitignored.
################################################################################

# Postgres (matches docker-compose.yml defaults)
PGHOST=localhost
PGPORT=5432
PGDATABASE=billing_rules
PGUSER=app
PGPASSWORD=app_dev_only_change_in_prod
PGSSLMODE=disable

# Admin role for migrations + break-glass
PG_ADMIN_USER=admin
PG_ADMIN_PASSWORD=admin_dev_only_change_in_prod

# AWS (Phase 0 — placeholder)
AWS_REGION=us-east-1
AWS_PROFILE=billing-rules-dev

# AMA CPT license token (apply via royalties portal Phase 0)
AMA_LICENSE_TOKEN=

# CMS Coverage API license token (request via /v1/metadata/license-agreement)
CMS_COVERAGE_API_TOKEN=

# Bedrock / LLM (Phase 1+)
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_SYNTHESIS=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_PARSER=anthropic.claude-3-5-haiku-20241022-v1:0

################################################################################
# Encounter transcription + note drafting.
#
# An encounter recording and its transcript are PHI. Both features are OFF
# until configured, and the cloud paths refuse to run without an explicit BAA
# acknowledgement. See docs/RUNBOOKS/transcription.md.
################################################################################

# RECOMMENDED — a Whisper-compatible endpoint you host yourself. Audio never
# leaves your infrastructure, so no BAA is required.
#   e.g. faster-whisper-server on the app VPS: http://127.0.0.1:9000
TRANSCRIPTION_URL=

# An OpenAI-compatible chat endpoint you host, used to draft the note.
NOTE_DRAFT_URL=
NOTE_DRAFT_MODEL=

# --- Cloud alternative. Only with a signed BAA in place. ---
# TRANSCRIPTION_PROVIDER=openai
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Set to the literal string "true" ONLY if a BAA covering PHI is signed with
# the provider above. Without it, both features stay disabled by design.
# PHI_BAA_ACKNOWLEDGED=
