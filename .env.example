################################################################################
# Local development environment template.
# Copy to .env and fill in real values. .env is gitignored.
################################################################################

# Postgres (matches docker-compose.yml defaults)
PGHOST=localhost
PGPORT=5432
PGDATABASE=billing_rules
PGUSER=app
PGPASSWORD=app_dev_only_change_in_prod
PGSSLMODE=disable

# Admin role for migrations + break-glass
PG_ADMIN_USER=admin
PG_ADMIN_PASSWORD=admin_dev_only_change_in_prod

# AWS (Phase 0 — placeholder)
AWS_REGION=us-east-1
AWS_PROFILE=billing-rules-dev

# AMA CPT license token (apply via royalties portal Phase 0)
AMA_LICENSE_TOKEN=

# CMS Coverage API license token (request via /v1/metadata/license-agreement)
CMS_COVERAGE_API_TOKEN=

# AI providers (lib/env.ts). Optional to boot, but the features that need them
# fail without them:
#   ANTHROPIC_API_KEY — rule synthesis, denial analysis, document rule extraction
#   OPENAI_API_KEY    — embeddings for vector search
# Never send PHI through either: no BAA is in place (vision §15.4, lib/ai/phi-guard.ts).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Clearinghouse connections (0120). PALLIO_TOKEN_KEY, 32+ characters, encrypts
# the saved SFTP / CAQH CORE / API credentials (and Google Calendar tokens);
# without it a connection's passwords cannot be saved. CRON_SECRET guards
# /api/cron/clearinghouse-poll, as it does the other cron routes.
PALLIO_TOKEN_KEY=
CRON_SECRET=
# Dev only: lets a connection reach 127.0.0.1, for the stand-in clearinghouse
# (node scripts/dev/mock-clearinghouse.mjs). Ignored when NODE_ENV=production.
# CLEARINGHOUSE_ALLOW_PRIVATE_HOSTS=1

# Bedrock / LLM (Phase 1+)
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_SYNTHESIS=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_PARSER=anthropic.claude-3-5-haiku-20241022-v1:0
